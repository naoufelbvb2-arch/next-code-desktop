{
  "name": "next-code-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated Windows desktop interface for Next Code",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node -e \"process.env.electron_config_cache=require('node:path').resolve('.cache/electron');require('electron/install.js')\"",
    "dev": "node electron/run.mjs",
    "start": "node electron/run.mjs preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "test": "vitest run",
    "test:electron": "playwright test",
    "format": "prettier --write contracts electron renderer tests *.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check contracts electron renderer tests *.config.ts tsconfig.json package.json .prettierrc.json",
    "verify:docs": "python docs/implementation/P0/verify_delivery.py --git-ref HEAD"
  },
  "dependencies": {
    "koffi": "3.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.14.0",
    "electron": "45.0.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "jsdom": "27.4.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
